# 留空则使用 InMemory（默认测试）。有值则启用 PostgreSQL 实现同一套 Port。
# DATABASE_URL=postgresql://ubuntu@/ai_clerk?host=/var/run/postgresql
DATABASE_URL=

# 留空则 LLMTurnParser 不发请求，直接规则解析（与 v0.2 同行为）。
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 真模型评测必须同时打开。仅有 LLM_API_KEY 时日常 pytest 仍不发请求。
# RUN_LIVE_LLM=1
