{
  "version": 1,
  "purpose": "parser_language_only",
  "notes": "只评 SpeechAct 语言槽。禁止期望 SKU、客户 ID、店名消歧、档案默认或行情价。",
  "cases": [
    {
      "id": "open-wang-apple",
      "text": "开老王的单苹果60件",
      "expected_acts": [
        {"type": "start_order", "slots": {"customer_mention": "老王"}},
        {"type": "set_line", "slots": {"product_mention": "苹果", "qty": 60, "uom": "件"}}
      ]
    },
    {
      "id": "open-wang-boss",
      "text": "开王老板的单",
      "expected_acts": [
        {"type": "start_order", "slots": {"customer_mention": "王老板"}}
      ]
    },
    {
      "id": "open-li",
      "text": "开李老板的单",
      "expected_acts": [
        {"type": "start_order", "slots": {"customer_mention": "李老板"}}
      ]
    },
    {
      "id": "apple-60",
      "text": "苹果60件",
      "expected_acts": [
        {"type": "set_line", "slots": {"product_mention": "苹果", "qty": 60, "uom": "件"}}
      ]
    },
    {
      "id": "pear-60",
      "text": "梨60件",
      "expected_acts": [
        {"type": "set_line", "slots": {"product_mention": "梨", "qty": 60, "uom": "件"}}
      ]
    },
    {
      "id": "add-golden-durian",
      "text": "加两个金边榴莲",
      "expected_acts": [
        {"type": "add_line", "slots": {"product_mention": "金边榴莲", "qty": 2, "uom": "个"}}
      ]
    },
    {
      "id": "burst-apple-pear-durian",
      "text": "苹果60件梨60件加两个金边榴莲",
      "expected_acts": [
        {"type": "set_line", "slots": {"product_mention": "苹果", "qty": 60, "uom": "件"}},
        {"type": "set_line", "slots": {"product_mention": "梨", "qty": 60, "uom": "件"}},
        {"type": "add_line", "slots": {"product_mention": "金边榴莲", "qty": 2}}
      ]
    },
    {
      "id": "correction-qty",
      "text": "不对榴莲改三个",
      "expected_acts": [
        {"type": "set_qty", "slots": {"product_mention": "榴莲", "qty": 3}}
      ]
    },
    {
      "id": "burst-with-correction",
      "text": "苹果60件梨60件加两个金边榴莲不对榴莲改三个",
      "expected_acts": [
        {"type": "set_line", "slots": {"product_mention": "苹果", "qty": 60, "uom": "件"}},
        {"type": "set_line", "slots": {"product_mention": "梨", "qty": 60, "uom": "件"}},
        {"type": "add_line", "slots": {"product_mention": "金边榴莲", "qty": 2}},
        {"type": "set_qty", "slots": {"product_mention": "榴莲", "qty": 3}}
      ]
    },
    {
      "id": "remove-pear",
      "text": "梨不要了",
      "expected_acts": [
        {"type": "remove_line", "slots": {"product_mention": "梨"}}
      ]
    },
    {
      "id": "add-more-qty",
      "text": "再加20件",
      "expected_acts": [
        {"type": "set_qty", "slots": {"qty": 20, "uom": "件", "mode": "add"}}
      ]
    },
    {
      "id": "explicit-price",
      "text": "苹果按3块",
      "expected_acts": [
        {"type": "set_price", "slots": {"product_mention": "苹果", "unit_price": 3}}
      ],
      "notes": "只抽原句数字，禁止补行情价"
    },
    {
      "id": "confirm",
      "text": "好了",
      "expected_acts": [
        {"type": "confirm_order", "slots": {}}
      ]
    },
    {
      "id": "confirm-those",
      "text": "就这些",
      "expected_acts": [
        {"type": "confirm_order", "slots": {}}
      ]
    },
    {
      "id": "anaphora-that-apple",
      "text": "那个苹果",
      "expected_acts": [
        {"type": "unknown", "slots": {"product_mention": "那个苹果"}}
      ],
      "notes": "禁止猜红富士"
    },
    {
      "id": "anaphora-previous",
      "text": "还是以前那个",
      "expected_acts": [
        {"type": "unknown", "slots": {"product_mention": "以前那个"}}
      ],
      "notes": "禁止猜 SKU，禁止标成 refine_spec"
    },
    {
      "id": "anaphora-just-now",
      "text": "刚才那个改80件",
      "expected_acts": [
        {"type": "set_qty", "slots": {"product_mention": "刚才那个", "qty": 80, "uom": "件"}}
      ]
    },
    {
      "id": "clarify-stall",
      "text": "3号档那个",
      "expected_acts": [
        {"type": "clarify", "slots": {"mention": "3号档那个"}}
      ],
      "notes": "只留提及，不解析成王强水果店"
    },
    {
      "id": "green-apple",
      "text": "青苹果60件",
      "expected_acts": [
        {"type": "set_line", "slots": {"product_mention": "青苹果", "qty": 60, "uom": "件"}}
      ]
    },
    {
      "id": "approx-qty",
      "text": "再给我来点苹果大概六十来件",
      "expected_acts": [
        {"type": "add_line", "slots": {"product_mention": "苹果", "qty": 60, "uom": "件"}}
      ],
      "notes": "口语约数，规则 Parser 可能切不好，留给 LLM"
    },
    {
      "id": "open-and-burst",
      "text": "开王老板的单，苹果60件，梨60件",
      "expected_acts": [
        {"type": "start_order", "slots": {"customer_mention": "王老板"}},
        {"type": "set_line", "slots": {"product_mention": "苹果", "qty": 60, "uom": "件"}},
        {"type": "set_line", "slots": {"product_mention": "梨", "qty": 60, "uom": "件"}}
      ]
    },
    {
      "id": "cancel",
      "text": "这单作废",
      "expected_acts": [
        {"type": "cancel_order", "slots": {}}
      ]
    }
  ]
}
